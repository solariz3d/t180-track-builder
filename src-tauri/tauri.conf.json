{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "T-180 Track Builder",
  "version": "0.2.2",
  "identifier": "com.solariz3d.t180-track-builder",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "T-180 Track Builder",
        "url": "app/index.html",
        "width": 1400,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "publisher": "solariz3d",
    "shortDescription": "Build Assetto Corsa tracks from words"
  }
}
